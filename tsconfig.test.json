{
  // M-19：测试代码类型检查。此前 tests/ 不在任何 tsconfig include 里，
  // 测试代码的类型错误永远发现不了（vitest/playwright 走 esbuild 转译不查类型）。
  // 用法：npm run typecheck:test（tsc --noEmit --composite false -p tsconfig.test.json）
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    // 与主进程 @electron-toolkit/tsconfig 一致：noImplicitAny:false（无声明模块如
    // better-sqlite3 隐式 any，不报 TS7016）。真实类型错误（如 muted:[] 与 DmaeAnomalyConfig
    // 不兼容）仍会被捕获。
    "noImplicitAny": false,
    "noEmit": true,
    "composite": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "src/test/**/*",
    "src/smoke.test.ts"
  ]
}
